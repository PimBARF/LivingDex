{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PokemonEvolutionDatabase",
  "description": "Schema for pre-compiled evolution trees and triggers",
  "type": "object",
  "patternProperties": {
    "^[0-9]+$": {
      "type": "object",
      "required": ["chainId", "nodes", "transitions"],
      "properties": {
        "chainId": {
          "type": "integer",
          "minimum": 1
        },
        "babyTriggerItem": {
          "type": ["string", "null"],
          "description": "Item required for breeding baby forms (e.g. 'sea-incense')"
        },
        "nodes": {
          "type": "array",
          "description": "All species belonging to this evolution family",
          "items": {
            "type": "object",
            "required": ["speciesId", "generation"],
            "properties": {
              "speciesId": { "type": "integer", "minimum": 1 },
              "name": { "type": "string" },
              "generation": { "type": "integer", "minimum": 1, "maximum": 9 },
              "isBaby": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "transitions": {
          "type": "array",
          "description": "Directed evolution links between species/forms",
          "items": {
            "type": "object",
            "required": ["fromSpeciesId", "toSpeciesId", "trigger"],
            "properties": {
              "fromSpeciesId": { "type": "integer", "minimum": 1 },
              "fromForm": { "type": ["string", "null"] },
              "toSpeciesId": { "type": "integer", "minimum": 1 },
              "toForm": { "type": ["string", "null"] },
              "trigger": {
                "type": "string",
                "description": "Evolution trigger mechanism (e.g. 'level-up', 'use-item', 'trade', 'shed', 'other')"
              },
              "minLevel": { "type": ["integer", "null"] },
              "item": { "type": ["string", "null"] },
              "heldItem": { "type": ["string", "null"] },
              "knownMove": { "type": ["string", "null"] },
              "knownMoveType": { "type": ["string", "null"] },
              "happiness": { "type": ["integer", "null"] },
              "timeOfDay": { "type": ["string", "null"] },
              "location": { "type": ["string", "null"] },
              "tradeSpeciesId": { "type": ["integer", "null"] },
              "partySpeciesId": { "type": ["integer", "null"] },
              "gender": { "type": ["string", "null"] },
              "description": {
                "type": "string",
                "description": "Human readable evolution requirement condition string"
              },
              "specialConditions": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
