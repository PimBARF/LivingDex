{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PokemonGameEncounterDatabase",
  "description": "Schema for game-specific encounter tables",
  "type": "object",
  "required": [
    "gameId",
    "encounters"
  ],
  "properties": {
    "gameId": {
      "type": "string",
      "description": "Unique internal game key (e.g. 'rby', 'gsc', 'swsh', 'sv')"
    },
    "encounters": {
      "type": "object",
      "description": "Encounter notes keyed by species or form ID",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "description": "Keyed by game version name, grouped versions (e.g. 'sword/shield'), or 'all'",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "locations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "method": { "type": ["string", "null"] },
              "evolveFrom": { "type": ["string", "null"] },
              "tradeFrom": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
